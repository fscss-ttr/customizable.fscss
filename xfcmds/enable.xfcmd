# xfcmds/enable.xfcmd
# libck customizable → yes  |  libon customizable
# https://github.com/fscss-ttr/customizable.fscss
say "Setting up {name}@{version} by {author}"
say "Needs FSCSS {fscss}. Import: @import((*) from customizable)"
add snippets for helpers
add snippet page-import "import customizable selective" as "@import((\n  page-root,\n  page-base,\n  page-nav,\n  page-hero,\n  page-btn,\n  page-btn-primary,\n  page-features,\n  page-feature-card,\n  page-cta-banner,\n  page-footer\n) from customizable)"
create file "customizable-demo/demo.fscss" with:
  /* customizable landing demo — generated by xfcmd */
  @import((*) from customizable)

  @page-root()
  @page-base(body)
  @page-nav(.page-nav)
  @page-badge(.page-badge)
  @page-hero(.page-hero)
  @page-btn(.page-btn)
  @page-btn-primary(.page-btn-primary)
  @page-btn-ghost(.page-btn-ghost)
  @page-features(.page-features)
  @page-feature-card(.page-feature-card)
  @page-cta-banner(.page-cta-banner)
  @page-footer(.page-footer)
  @page-footer-bottom(.page-footer-bottom)

  :root {
    --page-accent: #6366f1;
  }
end
create file "customizable-demo/index.html" with:
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>customizable.fscss demo</title>
    <link type="fscss" href="demo.fscss">
  </head>
  <body>
    <nav class="page-nav">
      <strong>Brand</strong>
      <div>
        <a href="#">Docs</a>
        <a href="#">GitHub</a>
      </div>
    </nav>

    <header class="page-hero">
      <span class="page-badge">FSCSS module</span>
      <h1>Ship pages with tokens, not one-off CSS</h1>
      <p>Navigation, hero, features, CTA, and footer — selectively imported and restyled per page.</p>
      <div>
        <a class="page-btn page-btn-primary" href="#">Get started</a>
        <a class="page-btn page-btn-ghost" href="#">View repo</a>
      </div>
    </header>

    <section class="page-features">
      <article class="page-feature-card">
        <h3>Selective import</h3>
        <p>Pull only the blocks you need.</p>
      </article>
      <article class="page-feature-card">
        <h3>Token-driven</h3>
        <p>Override --page-* on :root or a wrapper.</p>
      </article>
      <article class="page-feature-card">
        <h3>Pure CSS</h3>
        <p>Compile with the CLI for zero runtime.</p>
      </article>
    </section>

    <section class="page-cta-banner">
      <h2>Ready to customize?</h2>
      <p>Import the module and restyle with design tokens.</p>
      <a class="page-btn page-btn-primary" href="#">Open IDE</a>
    </section>

    <footer class="page-footer">
      <div>customizable.fscss</div>
      <div class="page-footer-bottom">MIT · fscss-ttr</div>
    </footer>
  </body>
  </html>
end
open file customizable-demo/demo.fscss
compile
open file customizable-demo/index.html
show preview
say "Done. Type page-root, page-hero, or page-nav for snippets."
say "Selective import keeps compiled CSS small — see README."
